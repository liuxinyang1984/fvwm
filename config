# FVWM CDE gray-green theme
# 安装后链到 ~/.fvwm；FVWM_USERDIR 默认为该目录
SetEnv fvwm_home $[FVWM_USERDIR]
SetEnv fvwm_confdir $[FVWM_USERDIR]/conf.d

Read $[fvwm_confdir]/00-base.conf
Read $[fvwm_confdir]/10-colorsets.conf
Read $[fvwm_confdir]/20-decor-cde.conf
Read $[fvwm_confdir]/30-bindings-window.conf
Read $[fvwm_confdir]/40-styles.conf
Read $[fvwm_confdir]/50-keys.conf
Read $[fvwm_confdir]/60-menus.conf
Read $[fvwm_confdir]/62-menu-windowops.conf
Read $[fvwm_confdir]/80-autostart.conf

# 本机私货（不在仓库内）。须用 $[HOME]：裸 $HOME 会被当成旧式 $H 变量拆坏
PipeRead `test -r $[HOME]/.config/fvwm/local.conf && echo Read $[HOME]/.config/fvwm/local.conf`
