#!/bin/sh
# fvwm3 会话（已有 DISPLAY）。安装名: ~/.local/bin/fvwm-session
#   fvwm-session
#   startx fvwm
#
# Arch 包名是 fvwm3（不是 fvwm）。失败会追加写入 ~/fvwm-session.log

LOG="${FVWM_SESSION_LOG:-$HOME/fvwm-session.log}"
log() { printf '%s\n' "$*" | tee -a "$LOG" >&2; }

log "===== $(date) DISPLAY=${DISPLAY:-} ====="

_common="${XDG_CONFIG_HOME:-$HOME/.config}/x11/session-common.sh"
if [ -f "$_common" ]; then
	# shellcheck source=/dev/null
	. "$_common"
else
	export PATH="${HOME}/.local/bin:/usr/local/bin:${PATH}"
	export GTK_IM_MODULE=fcitx QT_IM_MODULE=fcitx XMODIFIERS=@im=fcitx SDL_IM_MODULE=fcitx
fi
unset _common

if [ ! -f "${HOME}/.fvwm/config" ]; then
	log "缺少 ~/.fvwm/config；请先: ./install.sh desktop:fvwm"
	exit 1
fi

if ! command -v fvwm3 >/dev/null 2>&1; then
	log "fvwm3 not found in PATH=$PATH"
	log "请安装: sudo pacman -S fvwm3   （包名是 fvwm3，不是 fvwm）"
	sleep 2
	exit 1
fi

if ! command -v dbus-run-session >/dev/null 2>&1; then
	log "dbus-run-session not found；回退直接 exec fvwm3"
	exec fvwm3
fi

# fcitx5 / 壁纸由 ~/.fvwm 内 autostart 拉起
exec dbus-run-session -- fvwm3
