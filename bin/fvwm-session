#!/bin/sh
# fvwm 会话（已有 DISPLAY）。安装名: ~/.local/bin/fvwm-session
#   fvwm-session
#   startx fvwm
#
# 优先 fvwm3（Arch），否则 fvwm（Alpine 2.7 等）。失败追加 ~/fvwm-session.log

LOG="${FVWM_SESSION_LOG:-$HOME/fvwm-session.log}"
log() { printf '%s\n' "$*" | tee -a "$LOG" >&2; }

log "===== $(date) DISPLAY=${DISPLAY:-} ====="

_common="${XDG_CONFIG_HOME:-$HOME/.config}/x11/session-common.sh"
if [ -f "$_common" ]; then
	# shellcheck source=/dev/null
	. "$_common"
else
	export PATH="${HOME}/.local/bin:/usr/local/bin:${PATH}"
	export GTK_IM_MODULE=fcitx QT_IM_MODULE=fcitx XMODIFIERS=@im=fcitx SDL_IM_MODULE=fcitx
fi
unset _common

export FVWM_USERDIR="${FVWM_USERDIR:-$HOME/.fvwm}"
CONF="${FVWM_USERDIR}/config"

if [ ! -f "$CONF" ]; then
	log "缺少 $CONF；请先: ./install.sh desktop:fvwm"
	exit 1
fi

FVWM_BIN=""
for c in fvwm3 fvwm; do
	if command -v "$c" >/dev/null 2>&1; then
		FVWM_BIN=$(command -v "$c")
		break
	fi
done

if [ -z "$FVWM_BIN" ]; then
	log "未找到 fvwm3 或 fvwm（PATH=$PATH）"
	log "Arch: sudo pacman -S fvwm3    Alpine: sudo apk add fvwm"
	sleep 2
	exit 1
fi

log "使用 $FVWM_BIN -f $CONF（FVWM_USERDIR=$FVWM_USERDIR）"

# fcitx5 / 壁纸由 ~/.fvwm 内 autostart 拉起；-f 让 2.7 / 3 都读同一份 config
if ! command -v dbus-run-session >/dev/null 2>&1; then
	log "dbus-run-session not found；回退直接 exec"
	exec "$FVWM_BIN" -f "$CONF"
fi

exec dbus-run-session -- "$FVWM_BIN" -f "$CONF"
